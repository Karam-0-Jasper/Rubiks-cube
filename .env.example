# --- Database ---
# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/nuvex?schema=public"

# --- Auth ---
# A random string of at least 32 characters used to sign session tokens.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# --- Nyvora (Anthropic) ---
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: override the model Nyvora uses.
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Payments: mobile money ---
# Currency your merchant account settles in ("USD" or "LRD"). If you switch to
# LRD, update the plan amounts in src/lib/plans.ts to match.
PAYMENT_CURRENCY="USD"

# Lonestar Cell MoMo (MTN MoMo Collections API).
# From a Lonestar Cell / MTN MoMo merchant account (momodeveloper.mtn.com).
LONESTAR_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
LONESTAR_MOMO_SUBSCRIPTION_KEY=""   # Ocp-Apim-Subscription-Key for Collections
LONESTAR_MOMO_API_USER=""           # provisioned API user id (UUID)
LONESTAR_MOMO_API_KEY=""            # API key for that user
LONESTAR_MOMO_TARGET_ENV="sandbox"  # "sandbox" or your production target

# Orange Money (Orange Money Web Payment API).
# From an Orange Money Liberia merchant account (developer.orange.com).
# Confirm base URL, country segment and currency with Orange Liberia.
ORANGE_MONEY_BASE_URL="https://api.orange.com"
ORANGE_MONEY_TOKEN_URL=""           # optional; defaults to {BASE}/oauth/v3/token
ORANGE_MONEY_AUTH_HEADER=""         # the Basic auth header value issued to your app
ORANGE_MONEY_MERCHANT_KEY=""        # your merchant key
ORANGE_MONEY_COUNTRY="lr"           # webpay country path segment

# --- App ---
# Public base URL, used for payment return and callback URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret that enables the owner-only password reset page at /reset-password.
# Set this to a long random string; only someone who knows it can reset passwords.
ADMIN_RESET_KEY=

# Owner master login. When both are set, the owner can log into their own
# account using OWNER_ACCESS_CODE in the password field, in addition to their
# real password. Only applies to the account whose username is OWNER_USERNAME.
OWNER_USERNAME=
OWNER_ACCESS_CODE=
