# --- Database ---
# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/nuvex?schema=public"

# --- Auth ---
# A random string of at least 32 characters used to sign session tokens.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# --- Nyvora (Anthropic) ---
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: override the model Nyvora uses.
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs for each paid plan (create these in your Stripe dashboard).
STRIPE_PRICE_WEEKLY="price_..."
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."

# --- App ---
# Public base URL, used for Stripe redirect URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
